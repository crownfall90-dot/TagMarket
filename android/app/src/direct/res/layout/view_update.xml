<?xml version="1.0" encoding="utf-8"?>
<!-- Окно обновления поверх приложения: версия, прогресс загрузки, кнопка, если нужна -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#B3000000"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:id="@+id/update_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="12dp"
        android:background="@drawable/bg_card"
        android:elevation="12dp"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:id="@+id/update_eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.08"
            android:text="@string/update_eyebrow"
            android:textAllCaps="true"
            android:textColor="@color/muted"
            android:textSize="11.5sp" />

        <TextView
            android:id="@+id/update_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="-0.02"
            android:textColor="@color/text"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/update_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/muted"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/update_notes_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/update_whats_new"
            android:textColor="@color/text"
            android:textSize="14.5sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/update_notes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/muted"
            android:textSize="14sp"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/update_progress"
            style="@android:style/Widget.Material.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="18dp"
            android:indeterminate="true"
            android:progressDrawable="@drawable/bg_progress"
            android:indeterminateTint="@color/accent"
            android:max="100" />

        <Button
            android:id="@+id/update_action"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_primary"
            android:fontFamily="sans-serif-medium"
            android:stateListAnimator="@null"
            android:textAllCaps="false"
            android:textColor="@color/on_accent"
            android:textSize="16sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/update_manual"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@android:color/transparent"
            android:stateListAnimator="@null"
            android:text="@string/update_manual"
            android:textAllCaps="false"
            android:textColor="@color/accent"
            android:textSize="15sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/update_later"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@android:color/transparent"
            android:stateListAnimator="@null"
            android:text="@string/update_later"
            android:textAllCaps="false"
            android:textColor="@color/muted"
            android:textSize="15sp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
