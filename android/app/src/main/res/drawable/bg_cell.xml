<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape><solid android:color="@color/fill" /><stroke android:width="2dp" android:color="@color/text" /><corners android:radius="14dp" /></shape>
    </item>
    <item android:state_activated="true">
        <shape><solid android:color="@color/fill_strong" /><stroke android:width="1dp" android:color="@color/line" /><corners android:radius="14dp" /></shape>
    </item>
    <item>
        <shape><solid android:color="@color/fill" /><stroke android:width="1dp" android:color="@color/line" /><corners android:radius="14dp" /></shape>
    </item>
</selector>
