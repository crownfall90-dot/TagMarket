<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape><solid android:color="#1FC6F36A" /><stroke android:width="2dp" android:color="@color/accent" /><corners android:radius="14dp" /></shape>
    </item>
    <item android:state_activated="true">
        <shape><solid android:color="#14FFFFFF" /><stroke android:width="1dp" android:color="#55C6F36A" /><corners android:radius="14dp" /></shape>
    </item>
    <item>
        <shape><solid android:color="#0DFFFFFF" /><stroke android:width="1dp" android:color="#22FFFFFF" /><corners android:radius="14dp" /></shape>
    </item>
</selector>
