<?xml version="1.0" encoding="utf-8"?>
<!-- главная кнопка — инверсная капсула: белая в тёмной теме, чёрная в светлой -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape><solid android:color="@color/fill_strong" /><corners android:radius="28dp" /></shape>
    </item>
    <item>
        <shape><solid android:color="@color/accent" /><corners android:radius="28dp" /></shape>
    </item>
</selector>
