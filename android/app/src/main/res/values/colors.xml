<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Светлая тема Platformer; тёмная — в values-night. Какая открыта, решает выбор
         в настройках приложения (AppTheme задаёт экрану ночной режим сам). -->
    <color name="bg">#F3F3F5</color>
    <color name="panel">#FFFFFF</color>
    <color name="line">#E3E3E8</color>
    <color name="text">#111114</color>
    <color name="muted">#6B6B74</color>
    <color name="accent">#111114</color>
    <color name="on_accent">#FFFFFF</color>
    <color name="negative">#D93F3F</color>
    <color name="negative_fill">#14D93F3F</color>
    <!-- заливки поверх фона: ячейки кода, кружки шагов -->
    <color name="fill">#0D000000</color>
    <color name="fill_strong">#1A000000</color>
    <!-- цвет значка в шторке уведомлений: нейтральный серый, читается на светлой и тёмной -->
    <color name="notification">#5C5C64</color>
</resources>
