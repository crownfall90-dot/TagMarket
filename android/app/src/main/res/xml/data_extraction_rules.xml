<?xml version="1.0" encoding="utf-8"?>
<!-- Токен устройства не переносится в облачную копию и на другой телефон -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
