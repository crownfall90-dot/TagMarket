<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/login_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_glow" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:padding="24dp">

            <ImageView
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_marginStart="-14dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_launcher_foreground" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:letterSpacing="-0.04"
                android:text="@string/login_title"
                android:textColor="@color/text"
                android:textSize="32sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/login_hint"
                android:textColor="@color/muted"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/code"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="28dp"
                android:autofillHints="oneTimeCode"
                android:background="@drawable/bg_field"
                android:gravity="center"
                android:hint="@string/login_code"
                android:imeOptions="actionDone"
                android:importantForAutofill="yes"
                android:inputType="textCapCharacters|textNoSuggestions|textVisiblePassword"
                android:letterSpacing="0.18"
                android:maxLength="9"
                android:textColor="@color/text"
                android:textColorHint="@color/muted"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/negative"
                android:textSize="14sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/enter"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_primary"
                android:stateListAnimator="@null"
                android:text="@string/login_enter"
                android:textAllCaps="false"
                android:textColor="@color/on_accent"
                android:textSize="17sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/open_bot"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_secondary"
                android:stateListAnimator="@null"
                android:text="@string/login_open_bot"
                android:textAllCaps="false"
                android:textColor="@color/text"
                android:textSize="15sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
