<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/login_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:clipChildren="false">

    <ScrollView
        android:id="@+id/login_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/login_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="22dp"
            android:paddingVertical="28dp">

            <FrameLayout
                android:id="@+id/logo"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:background="@drawable/bg_logo_tile"
                android:elevation="10dp"
                android:outlineProvider="background">

                <ImageView
                    android:layout_width="124dp"
                    android:layout_height="124dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_splash" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="-0.03"
                android:text="@string/login_title"
                android:textColor="@color/text"
                android:textSize="30sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="@string/login_subtitle"
                android:textColor="@color/muted"
                android:textSize="15sp" />

            <LinearLayout
                android:id="@+id/card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- три шага -->
                <LinearLayout style="@style/LoginStep">
                    <TextView style="@style/LoginStepNumber" android:text="1" />
                    <TextView style="@style/LoginStepText" android:text="@string/login_step1" />
                </LinearLayout>

                <LinearLayout style="@style/LoginStep">
                    <TextView style="@style/LoginStepNumber" android:text="2" />
                    <TextView style="@style/LoginStepText" android:text="@string/login_step2" />
                </LinearLayout>

                <LinearLayout style="@style/LoginStep">
                    <TextView style="@style/LoginStepNumber" android:text="3" />
                    <TextView style="@style/LoginStepText" android:text="@string/login_step3" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/request_code"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_primary"
                    android:clickable="true"
                    android:contentDescription="@string/login_request"
                    android:elevation="6dp"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:outlineProvider="background">

                    <TextView
                        android:id="@+id/request_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:drawableStart="@drawable/ic_telegram"
                        android:drawablePadding="10dp"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center_vertical"
                        android:text="@string/login_request"
                        android:textColor="@color/on_accent"
                        android:textSize="17sp" />
                </FrameLayout>

                <TextView
                    android:id="@+id/sent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_sent"
                    android:lineSpacingExtra="2dp"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="11dp"
                    android:text="@string/login_sent"
                    android:textColor="@color/text"
                    android:textSize="13.5sp"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.08"
                    android:text="@string/login_code"
                    android:textAllCaps="true"
                    android:textColor="@color/muted"
                    android:textSize="11.5sp" />

                <!-- 8 ячеек кода; поверх — прозрачное поле ввода, оно принимает текст и вставку -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="10dp">

                    <LinearLayout
                        android:id="@+id/cells"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView style="@style/LoginCell" />
                        <TextView style="@style/LoginCell" />
                        <TextView style="@style/LoginCell" />
                        <TextView style="@style/LoginCell" />

                        <View
                            android:layout_width="10dp"
                            android:layout_height="2dp"
                            android:layout_marginHorizontal="4dp"
                            android:background="@color/line" />

                        <TextView style="@style/LoginCell" />
                        <TextView style="@style/LoginCell" />
                        <TextView style="@style/LoginCell" />
                        <TextView style="@style/LoginCell" />
                    </LinearLayout>

                    <EditText
                        android:id="@+id/code"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:autofillHints="oneTimeCode"
                        android:background="@android:color/transparent"
                        android:contentDescription="@string/login_code"
                        android:cursorVisible="false"
                        android:imeOptions="actionDone"
                        android:importantForAutofill="yes"
                        android:inputType="textCapCharacters|textNoSuggestions|textVisiblePassword"
                        android:textColor="@android:color/transparent"
                        android:textIsSelectable="false" />
                </FrameLayout>

                <TextView
                    android:id="@+id/error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:textColor="@color/negative"
                    android:textSize="13.5sp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/enter"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_secondary"
                    android:fontFamily="sans-serif-medium"
                    android:stateListAnimator="@null"
                    android:text="@string/login_enter"
                    android:textAllCaps="false"
                    android:textColor="@color/text"
                    android:textSize="16sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:drawableStart="@drawable/ic_lock"
                android:drawablePadding="6dp"
                android:gravity="center_vertical"
                android:text="@string/login_footer"
                android:textColor="@color/muted"
                android:textSize="12.5sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
